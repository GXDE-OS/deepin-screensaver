# Maintainer: CharOfString <root@charofstring.cc>
pkgbase=deepin-screensaver-git
pkgname=('deepin-screensaver-git' 'deepin-screensaver-xscreensaver-data-git')
pkgver=6.5.12
pkgrel=1
pkgdesc='Screensaver viewer and tools for GXDE'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/deepin-screensaver"
license=('GPL-3.0-or-later')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' 'dtk6core-git' 'dtk6gui-git' 'dtk6widget-git' 'qt6-base'
             'qt6-declarative' 'qt6-5compat' 'libx11' 'libxss' 'libxext' 'libxcb' 'gxde-desktop-base-git')
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  # 与 debian/rules 相同（Qt6） ・ Same as debian/rules (Qt6).
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DAPP_VERSION="$pkgver" \
    -DVERSION="$pkgver" \
    -DLIB_INSTALL_DIR=/usr/lib \
    -DQT_VERSION_MAJOR=6
  ninja -C build
  DESTDIR="$srcdir/root" ninja -C build install
}

# 按 debian/*.install 拆分 ・ Split as in debian/*.install.
_pick() {
  local _f
  for _f in "$@"; do
    install -d "$pkgdir/$(dirname "$_f")"
    mv "$_f" "$pkgdir/$_f"
  done
}

package_deepin-screensaver-git() {
  depends=('deepin-screensaver-xscreensaver-data-git' 'dtk6core-git' 'dtk6gui-git' 'dtk6widget-git'
           'qt6-base' 'qt6-declarative' 'libx11' 'libxss' 'libxext' 'libxcb' 'libgcc' 'libstdc++' 'glibc')
  provides=('deepin-screensaver')
  conflicts=('deepin-screensaver')

  cd "$srcdir/root"
  _pick usr/bin/deepin-screensaver usr/share/dbus-1/services usr/share/dbus-1/interfaces \
        usr/share/dsg/configs/org.deepin.screensaver/org.deepin.screensaver.json
  # 与 debian/deepin-screensaver.manpages 相同 ・ Same as debian/deepin-screensaver.manpages.
  install -Dm644 "$(_srcroot)/debian/deepin-screensaver.1" "$pkgdir/usr/share/man/man1/deepin-screensaver.1"
}

package_deepin-screensaver-xscreensaver-data-git() {
  pkgdesc='Screensaver modules for GXDE'
  # Debian 的 xscreensaver-data、-data-extra、-gl-extra 在 Arch 中都属于 xscreensaver
  # Debian's xscreensaver-data, -data-extra and -gl-extra are all part of
  # xscreensaver on Arch.
  depends=('xscreensaver' 'qt6-declarative' 'qt6-5compat' 'gxde-time-screensaver-git' 'dtk6core-git'
           'dtk6gui-git' 'dtk6widget-git' 'qt6-base' 'libgcc' 'libstdc++' 'glibc')
  provides=('deepin-screensaver-xscreensaver-data')
  conflicts=('deepin-screensaver-xscreensaver-data')

  cd "$srcdir/root"
  _pick usr/lib/deepin-screensaver/modules usr/share/deepin-custom-screensaver/translations \
        etc/deepin-screensaver/deepin-custom-screensaver \
        usr/share/dsg/configs/org.deepin.screensaver/org.deepin.customscreensaver.json

  # Debian 的 postinst 在安装时把 xscreensaver 的屏保链接进模块目录；这里直接随包提供，
  # 名单取自该 postinst，目标为 Arch 的 /usr/lib/xscreensaver
  # Debian's postinst links xscreensaver hacks into the module directory at
  # install time; ship the links instead, with the list taken from that
  # postinst and pointing at Arch's /usr/lib/xscreensaver.
  local _ss
  for _ss in $(sed -n 's/^for ss in \(.*\); do$/\1/p' \
                 "$(_srcroot)/debian/deepin-screensaver-xscreensaver-data.postinst"); do
    ln -s "../../xscreensaver/$_ss" "$pkgdir/usr/lib/deepin-screensaver/modules/$_ss"
  done
}
